#!/bin/bash
# Auto-load Engram on Claude startup

ENGRAM_PATH="${ENGRAM_PATH:-$HOME/code/tinydarkforge/Engram}"

# Check if Engram exists

  echo "⚠️  Engram not found at $ENGRAM_PATH"

# Load Engram context
echo "⬡ Loading Engram..."
node "$ENGRAM_PATH/scripts/engram-loader.js" startup

# Sync latest knowledge (background, non-blocking)
(cd "$ENGRAM_PATH" && git pull --quiet origin main 2>/dev/null &)
